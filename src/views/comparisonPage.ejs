<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
      background-color: rgb(246, 241, 236);
    }

    form {
      max-width: 400px;
      margin: 20px auto;
      padding: 20px;
      background-color: #f9f9f9;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: bold;
    }

    select {
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border: 1px solid #ddd;
      border-radius: 5px;
      box-sizing: border-box;
    }

    button {
      width: 100%;
      padding: 10px;
      background-color: #4caf50;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      margin-top: 20px;
    }

    th, td {
      border: 1px solid #ddd;
      padding: 12px;
      text-align: left;
    }

    th {
      background-color: #f2f2f2;
      font-weight: bold;
    }

    tr:nth-child(even) {
      background-color: #f9f9f9;
    }

    tr:hover {
      background-color: #e6e6e6;
    }

  </style>
</head>
<body class="bg-gray-100">
  <div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-4">Product Comparison</h1>
    <input type="text" id="searchBar" class="w-full p-2 border border-gray-300 rounded mb-4" placeholder="Search for products...">
    <form action="/compare" method="post" class="bg-white p-6 rounded shadow-md">
      <input type="hidden" name="productSelect" value="<%= productSelect %>">
      <input type="hidden" name="selectedCompanies" value="<%= selectedCompanies %>">

      <label for="sortBasis" class="block mb-2 font-bold">Sort on the Basis of:</label>
      <select name="sortBasis" class="w-full p-2 border border-gray-300 rounded mb-4">
        <option value="total_review_count">Total Review Count</option>
        <option value="rating">Rating</option>
        <option value="price">Price</option>
      </select>
      
      <label for="sortOrder" class="block mb-2 font-bold">Sort Order:</label>
      <select name="sortOrder" class="w-full p-2 border border-gray-300 rounded mb-4">
        <option value="asc">Ascending</option>
        <option value="desc">Descending</option>
      </select>

      <label for="topN" class="block mb-2 font-bold">Number of items to be shown:</label>
      <select name="topN" class="w-full p-2 border border-gray-300 rounded mb-4">
        <% for (let idx = 0; idx < selectedCompanies.length; idx++) { %>
          <option value="<%= idx + 1 %>"><%= idx + 1 %></option>
        <% } %>
      </select>

      <button type="submit" class="w-full p-2 bg-blue-500 text-white rounded">Rearrange</button>
    </form>
    <button id="compareButton" class="mt-4 p-2 bg-blue-500 text-white rounded">Compare Selected Products</button>
    <div id="comparisonTable" class="mt-4"></div>

    <table class="table-auto w-full mt-6 bg-white rounded shadow-md">
      <thead>
        <tr>
          <th class="px-4 py-2">Title</th>
          <th class="px-4 py-2">URL</th>
          <th class="px-4 py-2">Total Review Count</th>
          <th class="px-4 py-2">Rating</th>
          <th class="px-4 py-2">Price</th>
          <th class="px-4 py-2">Website</th>
        </tr>
      </thead>
      <tbody>
        <% requestedData.forEach((data, index) => { %>
          <tr class="hover:bg-gray-100">
            <td class="border px-4 py-2"><%= data.title %></td>
            <td class="border px-4 py-2"><a href="<%= data.url %>" target="_blank" class="text-blue-500"><%= data.url %></a></td>
            <td class="border px-4 py-2"><%= data.total_review_count %></td>
            <td class="border px-4 py-2"><%= data.rating %></td>
            <td class="border px-4 py-2">₹<%= data.price %></td>
            <td class="border px-4 py-2"><a href="<%= data.website %>" target="_blank" class="text-blue-500"><%= data.website %></a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <div id="reviewForm" class="mt-4 bg-white p-6 rounded shadow-md">
      <h2 class="text-2xl font-bold mb-2">Submit a Review</h2>
      <input type="text" id="reviewProduct" class="w-full p-2 border border-gray-300 rounded mb-2" placeholder="Product Name">
      <textarea id="reviewText" class="w-full p-2 border border-gray-300 rounded mb-2" placeholder="Your Review"></textarea>
      <input type="number" id="reviewRating" class="w-full p-2 border border-gray-300 rounded mb-2" placeholder="Rating (1-5)" min="1" max="5">
      <button id="submitReview" class="p-2 bg-green-500 text-white rounded">Submit Review</button>
    </div>
    <div id="reviewsList" class="mt-4">
      <h2 class="text-2xl font-bold mb-2">Reviews</h2>
      <!-- Reviews will be dynamically inserted here -->
    </div>
    <div id="priceAlertForm" class="mt-4 bg-white p-6 rounded shadow-md">
      <h2 class="text-2xl font-bold mb-2">Set Price Alert</h2>
      <input type="text" id="alertProduct" class="w-full p-2 border border-gray-300 rounded mb-2" placeholder="Product Name">
      <input type="number" id="alertPrice" class="w-full p-2 border border-gray-300 rounded mb-2" placeholder="Alert Price" min="0">
      <button id="setAlert" class="p-2 bg-red-500 text-white rounded">Set Alert</button>
    </div>
    <div id="alertsList" class="mt-4">
      <h2 class="text-2xl font-bold mb-2">Price Alerts</h2>
      <!-- Alerts will be dynamically inserted here -->
    </div>
    <div id="wishlist" class="mt-4">
      <h2 class="text-2xl font-bold mb-2">Wishlist</h2>
      <!-- Wishlist items will be dynamically inserted here -->
    </div>
  </div>
  <script>
    const searchBar = document.getElementById('searchBar');
    const tableRows = document.querySelectorAll('tbody tr');

    searchBar.addEventListener('input', () => {
      const searchTerm = searchBar.value.toLowerCase();
      tableRows.forEach(row => {
        const title = row.querySelector('td:first-child').textContent.toLowerCase();
        if (title.includes(searchTerm)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });

    function compareProducts() {
      const selectedProducts = [];
      document.querySelectorAll('.compare-checkbox:checked').forEach(checkbox => {
        const productId = checkbox.getAttribute('data-id');
        const product = requestedData.find(p => p.id === productId);
        if (product) {
          selectedProducts.push(product);
        }
      });

      if (selectedProducts.length > 0) {
        const comparisonTable = document.getElementById('comparisonTable');
        comparisonTable.innerHTML = `
          <table class="table-auto w-full mt-6 bg-white rounded shadow-md">
            <thead>
              <tr>
                <th class="px-4 py-2">Title</th>
                <th class="px-4 py-2">URL</th>
                <th class="px-4 py-2">Total Review Count</th>
                <th class="px-4 py-2">Rating</th>
                <th class="px-4 py-2">Price</th>
                <th class="px-4 py-2">Website</th>
              </tr>
            </thead>
            <tbody>
              ${selectedProducts.map(product => `
                <tr class="hover:bg-gray-100">
                  <td class="border px-4 py-2">${product.title}</td>
                  <td class="border px-4 py-2"><a href="${product.url}" target="_blank" class="text-blue-500">${product.url}</a></td>
                  <td class="border px-4 py-2">${product.total_review_count}</td>
                  <td class="border px-4 py-2">${product.rating}</td>
                  <td class="border px-4 py-2">₹${product.price}</td>
                  <td class="border px-4 py-2"><a href="${product.website}" target="_blank" class="text-blue-500">${product.website}</a></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      }
    }

    document.getElementById('compareButton').addEventListener('click', compareProducts);

    const reviews = [];

    function displayReviews() {
      const reviewsList = document.getElementById('reviewsList');
      reviewsList.innerHTML = `
        <h2 class="text-2xl font-bold mb-2">Reviews</h2>
        ${reviews.map(review => `
          <div class="bg-white p-4 rounded shadow mb-2">
            <h3 class="text-xl font-bold">${review.product}</h3>
            <p class="text-gray-700">${review.text}</p>
            <p class="text-gray-700">Rating: ${review.rating}</p>
          </div>
        `).join('')}
      `;
    }

    document.getElementById('submitReview').addEventListener('click', () => {
      const product = document.getElementById('reviewProduct').value;
      const text = document.getElementById('reviewText').value;
      const rating = document.getElementById('reviewRating').value;

      if (product && text && rating) {
        reviews.push({ product, text, rating });
        displayReviews();
      }
    });

    // Initial display
    displayReviews();

    const alerts = [];

    function displayAlerts() {
      const alertsList = document.getElementById('alertsList');
      alertsList.innerHTML = `
        <h2 class="text-2xl font-bold mb-2">Price Alerts</h2>
        ${alerts.map(alert => `
          <div class="bg-white p-4 rounded shadow mb-2">
            <h3 class="text-xl font-bold">${alert.product}</h3>
            <p class="text-gray-700">Alert Price: ₹${alert.price}</p>
          </div>
        `).join('')}
      `;
    }

    document.getElementById('setAlert').addEventListener('click', () => {
      const product = document.getElementById('alertProduct').value;
      const price = document.getElementById('alertPrice').value;

      if (product && price) {
        alerts.push({ product, price });
        displayAlerts();
      }
    });

    // Initial display
    displayAlerts();

    const wishlist = [];

    function displayWishlist() {
      const wishlistElement = document.getElementById('wishlist');
      wishlistElement.innerHTML = `
        <h2 class="text-2xl font-bold mb-2">Wishlist</h2>
        ${wishlist.map(item => `
          <div class="bg-white p-4 rounded shadow mb-2">
            <h3 class="text-xl font-bold">${item.name}</h3>
            <p class="text-gray-700">Price: ₹${item.price}</p>
          </div>
        `).join('')}
      `;
    }

    function addToWishlist(product) {
      wishlist.push(product);
      displayWishlist();
    }

    function displayProducts(filteredProducts) {
      productList.innerHTML = '';
      filteredProducts.forEach(product => {
        const productCard = document.createElement('div');
        productCard.className = 'bg-white p-4 rounded shadow';
        productCard.innerHTML = `
          <h2 class="text-xl font-bold">${product.name}</h2>
          <p class="text-gray-700">Price: ₹${product.price}</p>
          <button class="mt-2 p-2 bg-green-500 text-white rounded" onclick="addToWishlist(${JSON.stringify(product)})">Add to Wishlist</button>
        `;
        productList.appendChild(productCard);
      });
    }

    // Initial display
    displayProducts(requestedData);
    displayWishlist();
  </script>
</body>
</html>
