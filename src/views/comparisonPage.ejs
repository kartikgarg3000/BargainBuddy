<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f3f4f6;
    }

    .page-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }

    .card {
      background: white;
      border-radius: 1rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      transition: all 0.3s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .form-select {
      appearance: none;
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
      background-position: right 0.5rem center;
      background-repeat: no-repeat;
      background-size: 1.5em 1.5em;
      padding-right: 2.5rem;
    }

    .table-container {
      overflow-x: auto;
      border-radius: 0.5rem;
    }

    table {
      border-collapse: separate;
      border-spacing: 0;
      width: 100%;
    }

    th {
      background-color: #f8fafc;
      color: #1f2937;
      font-weight: 600;
      padding: 1rem;
      text-align: left;
      border-bottom: 2px solid #e5e7eb;
    }

    td {
      padding: 1rem;
      border-bottom: 1px solid #e5e7eb;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      font-weight: 500;
      border-radius: 0.5rem;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background-color: #3b82f6;
      color: white;
    }

    .btn-primary:hover {
      background-color: #2563eb;
    }

    .price-tag {
      font-weight: 600;
      color: #059669;
    }

    .rating-badge {
      background-color: #fef3c7;
      color: #92400e;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .review-count {
      color: #6b7280;
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  <div class="page-container">
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Product Comparison</h1>
      <p class="text-gray-600">Compare prices and features across different retailers</p>
    </header>

    <form action="/compare" method="post" class="card p-6 mb-8">
      <input type="hidden" name="productSelect" value="<%= productSelect %>">
      <input type="hidden" name="selectedCompanies" value="<%= selectedCompanies %>">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label for="sortBasis" class="block text-sm font-medium text-gray-700 mb-2">Sort by</label>
          <select name="sortBasis" class="form-select w-full p-2 border border-gray-300 rounded-lg">
            <option value="total_review_count">Total Review Count</option>
            <option value="rating">Rating</option>
            <option value="price">Price</option>
          </select>
        </div>

        <div>
          <label for="sortOrder" class="block text-sm font-medium text-gray-700 mb-2">Sort Order</label>
          <select name="sortOrder" class="form-select w-full p-2 border border-gray-300 rounded-lg">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
          </select>
        </div>

        <div>
          <label for="topN" class="block text-sm font-medium text-gray-700 mb-2">Items to show</label>
          <select name="topN" class="form-select w-full p-2 border border-gray-300 rounded-lg">
            <% for (let idx = 0; idx < selectedCompanies.length; idx++) { %>
              <option value="<%= idx + 1 %>"><%= idx + 1 %></option>
            <% } %>
          </select>
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-full mt-6">
        Update Comparison
      </button>
    </form>

    
      <div class="flex gap-6 mb-6 p-4 bg-white rounded-xl shadow-sm border border-gray-100">
  <div class="flex-1">
    <label class="block text-sm font-medium text-gray-600 mb-1">Min Price</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">₹</span>
      <input 
        type="number" 
        id="minPrice" 
        placeholder="Min"
        class="w-full pl-8 pr-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 outline-none"
      >
    </div>
  </div>
  
  <div class="flex-1">
    <label class="block text-sm font-medium text-gray-600 mb-1">Max Price</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">₹</span>
      <input 
        type="number" 
        id="maxPrice" 
        placeholder="Max"
        class="w-full pl-8 pr-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 outline-none"
      >
    </div>
  </div>
  
  <div class="flex items-end">
    <button 
      onclick="filterByPrice()"
      class="h-[42px] px-6 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-medium rounded-lg shadow-sm hover:shadow-md transition-all duration-200 flex items-center justify-center"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
      </svg>
      Filter
    </button>
  </div>
</div>

    <div id="comparisonTable" class="mb-8"></div>

    <div class="card">
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th>Retailer</th>
              <th>Reviews</th>
              <th>Rating</th>
              <th>Price</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% requestedData.forEach((data, index) => { %>
              <tr class="hover:bg-gray-50">
                <td class="font-medium text-gray-900"><%= data.title %></td>
                <td>
                  <a href="<%= data.website %>" target="_blank" class="text-blue-600 hover:text-blue-800">
                    <%= data.website.replace('https://', '').replace('.in', '') %>
                  </a>
                </td>
                <td class="review-count"><%= data.total_review_count %> reviews</td>
                <td><span class="rating-badge"><%= data.rating %> ★</span></td>
                <td class="price-tag">₹<%= Number(data.price).toLocaleString('en-IN') %></td>
                <td>
                  <a href="<%= data.url %>" target="_blank" class="btn btn-primary inline-block text-sm">
                    View Deal
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
    
    <!-- Saving Calculator  -->
<div class="card mt-8">
  <div class="p-6">
    <h2 class="text-2xl font-bold mb-4">Savings Calculator</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="font-semibold mb-2">Best Deal</h3>
        <div class="p-4 bg-green-50 rounded">
          <% const bestDeal = requestedData.reduce((a, b) => 
            Number(a.price) < Number(b.price) ? a : b); %>
          <p class="text-lg">
            <%= bestDeal.website.replace('https://', '').replace('.in', '') %>: 
            ₹<%= Number(bestDeal.price).toLocaleString('en-IN') %>
          </p>
          <p class="text-sm text-green-600">
            Rating: <%= bestDeal.rating %> ★ 
            (<%= bestDeal.total_review_count %> reviews)
          </p>
        </div>
      </div>
      <div>
        <h3 class="font-semibold mb-2">Potential Savings</h3>
        <div class="p-4 bg-blue-50 rounded">
          <% const maxPrice = Math.max(...requestedData.map(item => Number(item.price)));
             const savings = maxPrice - Number(bestDeal.price); %>
          <p class="text-lg">Up to ₹<%= savings.toLocaleString('en-IN') %></p>
          <p class="text-sm text-blue-600">
            <%= Math.round((savings/maxPrice) * 100) %>% cheaper than highest price
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
   

  <script>
    const searchBar = document.getElementById('searchBar');
    const tableRows = document.querySelectorAll('tbody tr');

    searchBar.addEventListener('input', () => {
      const searchTerm = searchBar.value.toLowerCase();
      tableRows.forEach(row => {
        const title = row.querySelector('td:first-child').textContent.toLowerCase();
        if (title.includes(searchTerm)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });

    function compareProducts() {
      const selectedProducts = [];
      document.querySelectorAll('.compare-checkbox:checked').forEach(checkbox => {
        const productId = checkbox.getAttribute('data-id');
        const product = requestedData.find(p => p.id === productId);
        if (product) {
          selectedProducts.push(product);
        }
      });

      if (selectedProducts.length > 0) {
        const comparisonTable = document.getElementById('comparisonTable');
        comparisonTable.innerHTML = `
          <table class="table-auto w-full mt-6 bg-white rounded shadow-md">
            <thead>
              <tr>
                <th class="px-4 py-2">Title</th>
                <th class="px-4 py-2">URL</th>
                <th class="px-4 py-2">Total Review Count</th>
                <th class="px-4 py-2">Rating</th>
                <th class="px-4 py-2">Price</th>
                <th class="px-4 py-2">Website</th>
              </tr>
            </thead>
            <tbody>
              ${selectedProducts.map(product => `
                <tr class="hover:bg-gray-100">
                  <td class="border px-4 py-2">${product.title}</td>
                  <td class="border px-4 py-2"><a href="${product.url}" target="_blank" class="text-blue-500">${product.url}</a></td>
                  <td class="border px-4 py-2">${product.total_review_count}</td>
                  <td class="border px-4 py-2">${product.rating}</td>
                  <td class="border px-4 py-2">₹${product.price}</td>
                  <td class="border px-4 py-2"><a href="${product.website}" target="_blank" class="text-blue-500">${product.website}</a></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      }
    }

    function filterByPrice() {
  const min = Number(document.getElementById('minPrice').value) || 0;
  const max = Number(document.getElementById('maxPrice').value) || Infinity;
  
  const rows = document.querySelectorAll('tbody tr');
  rows.forEach(row => {
    const price = Number(row.querySelector('.price-tag').textContent.replace('₹', '').replace(',', ''));
    row.style.display = (price >= min && price <= max) ? '' : 'none';
  });
}
    
  </script>
    <%- include('./footer') %> 
</body>
</html>
